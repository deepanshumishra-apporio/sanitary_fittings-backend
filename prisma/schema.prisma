// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  CUSTOMER
  ADMIN
  SUBADMIN
  DEALER
}

enum OrderStatus {
  PLACED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum VendorStockEntryType {
  INITIAL
  PURCHASE_BILL
  MANUAL_UPDATE
  ORDER_SOLD
  ORDER_CANCELLED
  ADJUSTMENT
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String?        @unique
  name          String?
  password      String?
  role          Role           @default(CUSTOMER)
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  addresses     Address[]
  orders        Order[]        @relation("CustomerOrders")
  dealerOrders  Order[]        @relation("DealerOrders")
  placedOrders  Order[]        @relation("PlacedOrders")
  payments      Payment[]
  refreshTokens RefreshToken[]
  vendorStockBills VendorStockBill[]
  vendorStockEntries VendorStockEntry[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  subCategories SubCategory[]
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SubCategory {
  id          String    @id @default(uuid())
  categoryId  String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products    Product[]

  @@unique([categoryId, name])
}

model Company {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  products    Product[]
  vendors     CompanyVendor[]
  rateEntries RateEntry[]
  stockBills   VendorStockBill[]
  stockEntries VendorStockEntry[]
}

model Vendor {
  id          String          @id @default(uuid())
  name        String
  email       String?         @unique
  phone       String?
  address     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  products    ProductVendor[]
  companies   CompanyVendor[]
  rateEntries RateEntry[]
  stockBills   VendorStockBill[]
  stockEntries VendorStockEntry[]
}

model CompanyVendor {
  id         String    @id @default(uuid())
  companyId  String
  vendorId   String
  code       String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([companyId, vendorId])
}

model ProductVendor {
  id        String   @id @default(uuid())
  productId String
  vendorId  String
  price     Float
  stock     Int
  sku       String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([productId, vendorId])
}

model Product {
  id          String          @id @default(uuid())
  name        String
  description String?
  price       Float
  discount    Float           @default(0)
  stock       Int
  images      String[]
  categoryId  String
  subCategoryId String?
  companyId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category    Category        @relation(fields: [categoryId], references: [id])
  subCategory SubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  vendors     ProductVendor[]
  rateEntries RateEntry[]
  stockEntries VendorStockEntry[]
}

model VendorStockBill {
  id          String    @id @default(uuid())
  vendorId    String
  companyId   String?
  billNo      String
  billDate    DateTime
  billAmount  Float?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries     VendorStockEntry[]

  @@index([vendorId, billDate])
  @@index([companyId, billDate])
  @@unique([vendorId, billNo, billDate])
}

model VendorStockEntry {
  id          String               @id @default(uuid())
  billId      String?
  productId   String
  vendorId    String
  companyId   String?
  orderId     String?
  type        VendorStockEntryType
  oldStock    Int
  changeQty   Int
  newStock    Int
  previousRate Float?
  rate        Float?
  notes       String?
  updatedById String?
  createdAt   DateTime             @default(now())

  bill        VendorStockBill?      @relation(fields: [billId], references: [id], onDelete: SetNull)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor      Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  company     Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order       Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  updatedBy   User?                 @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, vendorId, createdAt])
  @@index([vendorId, createdAt])
  @@index([billId])
  @@index([orderId])
}

model RateEntry {
  id            String    @id @default(uuid())
  productId     String
  vendorId      String
  companyId     String
  rate          Float
  previousRate  Float?
  effectiveDate DateTime
  billNo        String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, vendorId, effectiveDate])
  @@index([productId, effectiveDate])
  @@unique([productId, vendorId, companyId, effectiveDate, billNo])
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  dealerId   String?
  placedById   String?
  placedByRole Role?
  addressId  String?
  totalPrice Float
  discount   Float       @default(0)
  status     OrderStatus @default(PLACED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user       User        @relation("CustomerOrders", fields: [userId], references: [id])
  dealer     User?       @relation("DealerOrders", fields: [dealerId], references: [id], onDelete: SetNull)
  placedBy   User?       @relation("PlacedOrders", fields: [placedById], references: [id], onDelete: SetNull)
  address    Address?    @relation(fields: [addressId], references: [id])
  items      OrderItem[]
  payment    Payment?
  stockEntries VendorStockEntry[]

  @@index([dealerId, createdAt])
  @@index([placedById, createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  discount  Float   @default(0)

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String?
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  orders    Order[]
}

model Payment {
  id        String        @id @default(uuid())
  userId    String
  orderId   String        @unique
  amount    Float
  status    PaymentStatus @default(UNPAID)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  order     Order         @relation(fields: [orderId], references: [id])
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}
